<view class="page"><view class="title">我的校园拾集</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!user}}" class="empty"><view>登录后管理商品和学生认证</view><button class="primary" bindtap="login">登录</button></view><block wx:else><view class="panel section"><view class="row"><button open-type="chooseAvatar" bindchooseavatar="avatar" class="avatar"><image wx:if="{{avatar}}" src="{{avatar}}"/><text wx:else>我</text></button><view class="grow" bindtap="editName"><view class="section-title">{{user.nickname}}</view><text class="badge">{{statusText}}</text></view><view class="credit"><view>{{user.creditScore}}</view><text>信誉分</text></view></view><view class="safe-note">点击昵称可修改，点击头像可更换。</view></view><view class="panel"><view class="line row" bindtap="certify"><text>学生实名认证</text><text class="muted">{{statusText}}　›</text></view><view class="line row" bindtap="orders"><text>我的订单</text><text class="muted">买卖交易记录　›</text></view><view class="line row" bindtap="mine"><text>我的商品</text><text class="muted">查看与管理　›</text></view><view wx:if="{{user.role === 'ADMIN'}}" class="line row" bindtap="admin"><text>监管工作台</text><text class="muted">审核与平台监管　›</text></view></view><view class="panel"><view class="line row" bindtap="community" data-mode="conversations"><text>我的咨询</text><text class="muted">站内消息　›</text></view><view class="line row" bindtap="community" data-mode="favorites"><text>我的收藏</text><text class="muted">收藏商品　›</text></view><view class="line row" bindtap="community" data-mode="reports"><text>我的举报</text><text class="muted">查看处理结果　›</text></view></view><view class="panel"><view class="section-title">隐私信息</view><view class="line row"><text>姓名</text><text class="muted">{{user.maskedName || '尚未提交'}}</text></view><view class="line row"><text>学号</text><text class="muted">{{user.maskedStudentId || '尚未提交'}}</text></view><view class="line row"><text>手机号</text><text class="muted">{{user.maskedPhone || '尚未提交'}}</text></view></view><button class="secondary" bindtap="logout">退出登录</button></block></view>
