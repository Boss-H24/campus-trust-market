.side-tabs{display:flex;gap:8rpx;background:#FFDFBB;padding:8rpx;border-radius:18rpx;margin:28rpx 0}.side-tabs button{flex:1;width:auto;min-height:74rpx;line-height:58rpx;font-size:26rpx;border-radius:12rpx;background:transparent;color:#6A8071}.side-tabs button.active{background:#D9361C;color:#fff;font-weight:600}
.order-card{padding:24rpx}.order-head{padding-bottom:20rpx;border-bottom:1rpx solid #EDF1ED}.order-no{font-size:22rpx;color:#849087}.product-row{align-items:flex-start;padding-top:22rpx}.thumbnail{flex-shrink:0;width:142rpx;height:142rpx;border-radius:12rpx;background:#E3EDE5}.product-title{font-size:29rpx;font-weight:600;line-height:1.45;margin-bottom:10rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.price{margin-top:12rpx}.end-note{text-align:center;color:#98A097;font-size:22rpx;padding:18rpx 0 30rpx}
