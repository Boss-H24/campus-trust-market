<view class="page"><view class="title">举报{{targetType === 'PRODUCT' ? '商品' : '用户'}}</view><view class="subtitle">请如实说明，处理结果会在“我的举报”中展示。</view><view class="panel section"><view class="section-title">举报原因</view><input value="{{reason}}" data-field="reason" bindinput="input" maxlength="100" placeholder="例如：商品违规、虚假描述"/><view class="section-title">补充说明</view><textarea value="{{description}}" data-field="description" bindinput="input" maxlength="1000" placeholder="描述问题及站内沟通经过，请勿填写真实身份信息"/></view><view wx:if="{{error}}" class="error">{{error}}</view><button class="danger" bindtap="submit" disabled="{{submitting || !reason}}" loading="{{submitting}}">提交举报</button></view>
