<view class="page chat-page"><view class="safe-note">请使用站内咨询，勿发送联系方式或私下转账。</view><view wx:if="{{error}}" class="error">{{error}}</view><scroll-view class="messages" scroll-y scroll-into-view="{{scrollId}}" scroll-with-animation><view wx:for="{{items}}" wx:key="id" id="message-{{item.id}}" class="message {{item.senderId === userId ? 'mine' : ''}}"><text class="muted">{{item.senderId === userId ? '我' : '对方'}}</text><view class="bubble"><text user-select>{{item.content}}</text></view></view><view wx:if="{{!items.length}}" class="empty">发送第一条咨询消息</view></scroll-view><view class="composer"><textarea value="{{content}}" bindinput="input" maxlength="1000" placeholder="输入消息（最多1000字）" disabled="{{sending}}"/><button class="primary" bindtap="send" loading="{{sending}}" disabled="{{sending || !content}}">发送</button></view></view>
