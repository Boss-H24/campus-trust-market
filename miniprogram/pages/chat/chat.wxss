.chat-page { height: 94vh; display: flex; flex-direction: column; box-sizing: border-box; } .messages { flex: 1; min-height: 0; } .message { margin: 24rpx 0; max-width: 85%; } .mine { margin-left: auto; text-align: right; } .bubble { background: #fff; padding: 22rpx; border-radius: 16rpx; text-align: left; overflow-wrap: anywhere; white-space: pre-wrap; } .mine .bubble { background: #e7efda; } .composer { display: flex; gap: 16rpx; align-items: center; padding: 20rpx 0; } .composer textarea { flex: 1; height: 110rpx; background: #fff; padding: 12rpx; border-radius: 12rpx; } .composer button { margin: 0; }
