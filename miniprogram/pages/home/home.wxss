.welcome{position:relative;padding:18rpx 0 30rpx}.welcome .title{font-size:48rpx}.campus-mark{position:absolute;right:0;top:20rpx;color:#166855;font-size:23rpx;border:2rpx solid #166855;border-radius:50%;width:104rpx;height:104rpx;display:flex;align-items:center;justify-content:center;transform:rotate(9deg)}.search-row{display:flex;gap:12rpx}.search-row input{flex:1;min-width:0;background:#fff}.search-row button{height:88rpx;line-height:88rpx}.categories{white-space:nowrap;margin-top:24rpx}.category{display:inline-block;padding:12rpx 24rpx;margin-right:12rpx;color:#64746E;border-radius:24rpx}.category.selected{background:#166855;color:#fff}.section-title{margin-bottom:16rpx}.filter-link{font-size:24rpx;color:#166855}.product-grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}.product{background:#fff;border-radius:14rpx;overflow:hidden;min-width:0}.cover{width:100%;height:300rpx;display:block;background:#DCEAE2}.placeholder{display:flex;align-items:center;justify-content:center;color:#166855}.product-copy{padding:18rpx}.product-title{font-size:28rpx;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:14rpx}.product .price{font-size:32rpx}.product .muted{font-size:20rpx}.end-note{text-align:center;font-size:23rpx;color:#64746E;margin:38rpx 0}.panel input{padding:12rpx;font-size:23rpx;height:70rpx}
