or:#718078;border-radius:14rpx;font-size:25rpx}.category.selected{background:#166855;color:#fff;font-weight:600}.list-heading{margin-top:36rpx;margin-bottom:20rpx;align-items:baseline}.list-heading .section-title{margin-bottom:0;font-size:32rpx}.list-heading .muted{font-size:21rpx;display:block;margin-top:3rpx;font-weight:400}.filter-link{font-size:23rpx;color:#166855;padding:12rpx 0 12rpx 12rpx}.product-grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}.product{background:#fff;border-radius:22rpx;overflow:hidden;min-width:0;border:1rpx solid #E3EBE6}.cover-wrap{position:relative}.cover{width:100%;height:290rpx;display:block;background:#E2EDE4}.placeholder{display:flex;align-items:center;justify-content:center;color:#6B8D79}.campus-tag{position:absolute;bottom:14rpx;left:14rpx;background:rgba(255,255,255,.9);color:#496452;font-size:19rpx;padding:4rpx 10rpx;border-radius:7rpx}.product-copy{padding:19rpx 20rpx 22rpx}.product-title{font-size:27rpx;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:12rpx}.product .price{font-size:34rpx;white-space:nowrap}.currency{font-size:23rpx;margin-right:3rpx}.item-note{font-size:18rpx;color:#9AA69C}.end-note{text-align:center;font-size:22rpx;color:#8A9A8F;margin:40rpx 0 12rpx}.price-filter{padding:18rpx;gap:12rpx}.price-filter input{flex:1;min-width:0;padding:12rpx;font-size:23rpx;height:70rpx}.price-filter button{flex:0 0 90rpx;width:90rpx;padding:0}.empty-symbol{width:80rpx;height:80rpx;line-height:80rpx;margin:0 auto 20rpx;border-radius:26rpx;background:#E3EEE6;color:#78A087;font-size:38rpx}
