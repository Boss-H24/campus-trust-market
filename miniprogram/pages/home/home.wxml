<view class="page home-page">
  <view class="market-hero">
  <view class="market-top"><view class="brand-sign">拾</view><view class="market-copy"><view class="market-title">校园好物，放心淘</view><view class="market-subtitle">同学之间的闲置集市</view></view><text class="school-tag">校内转让</text></view>
  <view class="search-row"><view class="search-icon"></view><input placeholder="搜索教材、键盘、宿舍好物" value="{{keyword}}" data-field="keyword" bindinput="input" bindconfirm="search" confirm-type="search"/><button class="primary small" bindtap="search">搜索</button></view>
  <view class="trust-strip"><text>学生实名</text><text class="trust-dot">·</text><text>商品审核</text><text class="trust-dot">·</text><text>隐私保护</text><text class="trust-tip">让闲置遇见下一位同学</text></view>
  </view>
  <scroll-view scroll-x class="categories"><view class="category {{categoryId === '' ? 'selected' : ''}}" data-id="" bindtap="chooseCategory"><view class="category-icon all-category">集</view><text>全部好物</text></view><view wx:for="{{categories}}" wx:key="id" class="category {{categoryId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseCategory"><view class="category-icon tone-{{index % 4}}">{{item.symbol}}</view><text>{{item.name}}</text></view></scroll-view>
  <view class="deals"><view class="deal budget-deal {{activeDeal === 'budget' ? 'active-deal' : ''}}" data-deal="budget" bindtap="chooseDeal"><view class="deal-title">50元以内</view><text>小预算，也有好物</text></view><view class="deal books-deal {{activeDeal === 'books' ? 'active-deal' : ''}}" data-deal="books" bindtap="chooseDeal"><view class="deal-title">教材专区</view><text>学习装备接力</text></view><view class="deal dorm-deal {{activeDeal === 'dorm' ? 'active-deal' : ''}}" data-deal="dorm" bindtap="chooseDeal"><view class="deal-title">宿舍好物</view><text>给生活添点舒适</text></view></view>
  <view class="row list-heading"><view class="section-title">在售好物<text class="count">{{total}} 件</text></view><text class="filter-link {{showFilters ? 'filter-open' : ''}}" bindtap="toggleFilters">价格筛选 {{showFilters ? '−' : '＋'}}</text></view>
  <view wx:if="{{showFilters}}" class="panel row price-filter"><input class="grow" type="digit" placeholder="最低价（元）" value="{{minPrice}}" data-field="minPrice" bindinput="input"/><text>至</text><input class="grow" type="digit" placeholder="最高价（元）" value="{{maxPrice}}" data-field="maxPrice" bindinput="input"/><button class="secondary small" bindtap="search">筛选</button></view>
  <view wx:if="{{hasFilters}}" class="filter-summary"><text>已筛选</text><text wx:if="{{keyword}}">“{{keyword}}”</text><text wx:if="{{minPrice !== ''}}">最低 ¥{{minPrice}}</text><text wx:if="{{maxPrice !== ''}}">最高 ¥{{maxPrice}}</text><text class="reset-filter" bindtap="resetFilters">清除筛选</text></view>
  <view wx:if="{{error}}" class="error" bindtap="search">{{error}}，点击重试</view>
  <view class="product-grid"><view wx:for="{{items}}" wx:key="id" class="product" data-id="{{item.id}}" bindtap="open"><view class="cover-wrap"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" class="cover"/><view wx:else class="cover placeholder">校园好物</view><text class="campus-tag">校内闲置</text></view><view class="product-copy"><view class="product-title">{{item.title}}</view><view class="meta-row"><text class="condition-chip">{{item.conditionText}}</text><text class="handoff">校内交接</text></view><view class="price-line"><text class="price"><text class="currency">¥</text>{{item.priceText}}</text><text class="audit-label">审核上架</text></view></view></view></view>
  <view wx:if="{{loading}}" class="end-note">正在寻找校园好物…</view>
  <view wx:elif="{{!items.length && !error}}" class="empty"><view class="empty-symbol">拾</view><view>暂时没有找到这件好物</view><text class="muted">换个关键词，或试试其他分类</text><button wx:if="{{hasFilters}}" class="secondary small" bindtap="resetFilters">查看全部好物</button></view>
  <view wx:elif="{{items.length >= total}}" class="end-note">好物继续用，闲置不浪费</view>
</view>
