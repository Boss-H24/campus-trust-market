<view class="page"><view class="title">我的商品</view><view class="subtitle">共 {{total}} 件闲置，状态在这里查看</view><view wx:if="{{error}}" class="error" bindtap="retry">{{error}}，点击重试</view><view wx:for="{{items}}" wx:key="id" class="panel section"><view class="row" data-id="{{item.id}}" bindtap="open"><image src="{{item.cover}}" class="thumbnail" mode="aspectFill"/><view class="grow"><view class="section-title">{{item.title}}</view><view class="row"><text class="price">¥{{item.priceText}}</text><text class="badge {{item.status === 'PENDING' ? 'warning' : ''}}">{{item.statusText}}</text></view></view></view><view wx:if="{{item.rejectionReason}}" class="error">审核意见：{{item.rejectionReason}}</view><view class="actions"><button wx:if="{{item.status === 'ON_SALE' || item.status === 'PENDING' || item.status === 'REJECTED' || item.status === 'OFF_SHELF'}}" class="secondary small" data-id="{{item.id}}" bindtap="edit">编辑</button><button wx:if="{{item.status === 'ON_SALE'}}" class="secondary small" data-id="{{item.id}}" data-action="TAKE_DOWN" bindtap="action">下架</button><button wx:if="{{item.status === 'OFF_SHELF' || item.status === 'REJECTED'}}" class="primary small" data-id="{{item.id}}" data-action="SUBMIT" bindtap="action">重新提交审核</button></view></view><view wx:if="{{!loading &amp;&amp; !items.length &amp;&amp; !error}}" class="empty">还没有发布商品，去“发布闲置”试试</view><view wx:if="{{loading}}" class="empty">正在加载…</view></view>
