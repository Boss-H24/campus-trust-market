<view class="page"><view class="title">审核工作台</view><view class="subtitle">核验身份与商品，维护可信校园</view><view class="tabs section"><button class="{{mode === 'certifications' ? 'primary' : 'secondary'}}" data-mode="certifications" bindtap="choose">学生认证</button><button class="{{mode === 'products' ? 'primary' : 'secondary'}}" data-mode="products" bindtap="choose">商品审核</button></view><view wx:if="{{error}}" class="error" bindtap="load">{{error}}，点击重试</view><view wx:for="{{items}}" wx:key="id" class="panel section"><block wx:if="{{mode === 'certifications'}}"><view class="row"><view class="section-title">{{item.nickname}}</view><text class="badge warning">待审核</text></view><view class="muted">本校演示学籍校验已匹配</view><view class="line">学校：{{item.school}}</view><view class="line">姓名：{{item.maskedName}}　学号：{{item.maskedStudentId}}</view><view class="line">手机号：{{item.maskedPhone}}</view><view class="actions"><button class="danger small" data-id="{{item.certificationId}}" data-action="REJECT" data-version="{{item.version}}" bindtap="audit">驳回</button><button class="primary small" data-id="{{item.certificationId}}" data-action="APPROVE" data-version="{{item.version}}" bindtap="audit">通过认证</button></view></block><block wx:else><view class="row" data-id="{{item.id}}" bindtap="open"><image class="thumbnail" src="{{item.cover}}" mode="aspectFill"/><view class="grow"><view class="section-title">{{item.title}}</view><text class="price">¥{{item.priceText}}</text></view></view><view class="safe-note">{{item.description}}</view><view class="muted" data-id="{{item.id}}" bindtap="open">查看全部图片及详情 ›</view><view class="actions"><button class="danger small" data-id="{{item.id}}" data-action="REJECT" data-version="{{item.version}}" bindtap="audit">驳回</button><button class="primary small" data-id="{{item.id}}" data-action="APPROVE" data-version="{{item.version}}" bindtap="audit">审核上架</button></view></block></view><view wx:if="{{!loading &amp;&amp; !items.length &amp;&amp; !error}}" class="empty">待审事项已处理完毕</view><view wx:if="{{loading}}" class="empty">正在加载待审事项…</view></view>
