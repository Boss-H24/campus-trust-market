<view class="page">
  <view class="title">监管工作台</view><view class="subtitle">核验身份与商品，维护可信校园</view>
  <view class="tabs section"><button class="{{mode === 'certifications' ? 'primary' : 'secondary'}}" data-mode="certifications" bindtap="choose">学生认证</button><button class="{{mode === 'products' ? 'primary' : 'secondary'}}" data-mode="products" bindtap="choose">商品审核</button></view>
  <view class="tabs section"><button class="{{mode === 'reports' ? 'primary' : 'secondary'}}" data-mode="reports" bindtap="choose">举报工单</button><button class="{{mode === 'users' ? 'primary' : 'secondary'}}" data-mode="users" bindtap="choose">账号管理</button><button class="{{mode === 'frozen' ? 'primary' : 'secondary'}}" data-mode="frozen" bindtap="choose">冻结商品</button></view>
  <view class="tabs section"><button class="{{mode === 'categories' ? 'primary' : 'secondary'}}" data-mode="categories" bindtap="choose">商品分类</button><button class="{{mode === 'rules' ? 'primary' : 'secondary'}}" data-mode="rules" bindtap="choose">平台规则</button><button class="{{mode === 'logs' ? 'primary' : 'secondary'}}" data-mode="logs" bindtap="choose">操作日志</button></view>
  <button wx:if="{{mode === 'categories'}}" class="primary" bindtap="addCategory">新增分类</button>
  <view wx:if="{{error}}" class="error" bindtap="retry">{{error}}，点击重试</view>
  <view wx:for="{{items}}" wx:key="index" class="panel section">
    <block wx:if="{{mode === 'certifications'}}"><view class="row"><view class="section-title">{{item.nickname}}</view><text class="badge warning">待审核</text></view><view class="muted">本校演示学籍校验已匹配</view><view class="line">学校：{{item.school}}</view><view class="line">姓名：{{item.maskedName}}　学号：{{item.maskedStudentId}}</view><view class="line">手机号：{{item.maskedPhone}}</view><view class="actions"><button class="danger small" data-id="{{item.certificationId}}" data-action="REJECT" data-version="{{item.version}}" bindtap="audit" disabled="{{busy}}">驳回</button><button class="primary small" data-id="{{item.certificationId}}" data-action="APPROVE" data-version="{{item.version}}" bindtap="audit" disabled="{{busy}}">通过认证</button></view></block>
    <block wx:elif="{{mode === 'products'}}"><view class="row" data-id="{{item.id}}" bindtap="open"><image class="thumbnail" src="{{item.cover}}" mode="aspectFill"/><view class="grow"><view class="section-title">{{item.title}}</view><text class="price">¥{{item.priceText}}</text></view></view><view class="safe-note">{{item.description}}</view><view class="muted" data-id="{{item.id}}" bindtap="open">查看全部图片及详情 ›</view><view class="actions"><button class="danger small" data-id="{{item.id}}" data-action="REJECT" data-version="{{item.version}}" bindtap="audit" disabled="{{busy}}">驳回</button><button class="primary small" data-id="{{item.id}}" data-action="APPROVE" data-version="{{item.version}}" bindtap="audit" disabled="{{busy}}">审核上架</button></view></block>
    <block wx:elif="{{mode === 'reports'}}"><view class="row"><text class="section-title">举报 #{{item.id}}</text><text class="badge">{{item.status === 'PENDING' ? '待处理' : item.status === 'INVESTIGATING' ? '调查中' : item.status === 'UPHELD' ? '举报成立' : item.status === 'REJECTED' ? '已驳回' : '已关闭'}}</text></view><view class="line">{{item.targetType === 'PRODUCT' ? '商品' : '用户'}} #{{item.targetId}} · {{item.reason}}</view><view class="muted">{{item.description}}</view><view wx:if="{{item.resolutionReason}}" class="line">处理理由：{{item.resolutionReason}}</view><view class="actions"><button class="secondary small" data-id="{{item.id}}" bindtap="evidence">查看相关凭证</button><button wx:if="{{item.status === 'PENDING'}}" class="secondary small" data-id="{{item.id}}" data-version="{{item.version}}" data-action="INVESTIGATE" bindtap="progress" disabled="{{busy}}">开始调查</button></view><view wx:if="{{item.status === 'PENDING' || item.status === 'INVESTIGATING'}}" class="actions"><button class="secondary small" data-id="{{item.id}}" data-decision="REJECTED" bindtap="resolve" disabled="{{busy}}">驳回举报</button><button class="danger small" data-id="{{item.id}}" data-decision="UPHELD" bindtap="resolve" disabled="{{busy}}">成立并处置</button></view><button wx:if="{{item.status === 'UPHELD' || item.status === 'REJECTED'}}" class="secondary small" data-id="{{item.id}}" data-version="{{item.version}}" data-action="CLOSE" bindtap="progress" disabled="{{busy}}">关闭工单</button></block>
    <block wx:elif="{{mode === 'users'}}"><view class="row"><text class="section-title">{{item.nickname}}</text><text class="badge">{{item.status === 'ACTIVE' ? '正常' : '已禁用'}}</text></view><view class="line">信誉 {{item.creditScore}} · {{item.certificationStatus}}</view><button class="secondary small" data-id="{{item.id}}" data-status="{{item.status}}" bindtap="toggleUser" disabled="{{busy}}">{{item.status === 'ACTIVE' ? '禁用账号' : '恢复账号'}}</button></block>
    <block wx:elif="{{mode === 'frozen'}}"><view class="section-title">{{item.title}}</view><text class="badge warning">监管冻结{{item.status === 'LOCKED' ? ' · 交易锁定' : ''}}</text><button class="secondary small" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="unfreeze" disabled="{{busy}}">解除冻结</button></block>
    <block wx:elif="{{mode === 'categories'}}"><view class="row"><text class="section-title">{{item.name}}</text><text class="badge">{{item.active ? '已启用' : '已停用'}}</text></view><button class="secondary small" data-id="{{item.id}}" bindtap="category" disabled="{{busy}}">改名 / 启用 / 停用</button></block>
    <block wx:elif="{{mode === 'rules'}}"><view class="section-title">{{item.key === 'blocked_keywords' ? '禁止关键词' : item.key === 'publish_per_minute' ? '每分钟发布上限' : item.key === 'messages_per_minute' ? '每分钟消息上限' : item.key === 'reports_per_minute' ? '每分钟举报上限' : '发布最低信誉分'}}</view><view class="muted">{{item.valueText}}</view><button class="secondary small" data-key="{{item.key}}" bindtap="editRule" disabled="{{busy}}">更新规则</button></block>
    <block wx:else><view class="section-title">{{item.action}}</view><view class="muted">目标 {{item.target}} · 操作者 #{{item.actorId}}</view><view class="safe-note">{{item.createdAt}}</view></block>
  </view>
  <view wx:if="{{!loading && !items.length && !error}}" class="empty">暂无记录</view><view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:if="{{evidenceReport}}" class="panel section"><view class="section-title">举报 #{{evidenceReport}} 的相关凭证</view><view wx:for="{{evidence}}" wx:key="id" class="line"><text class="muted">发送者 #{{item.senderId}}：</text><text user-select>{{item.content}}</text></view><button wx:if="{{evidenceMore}}" class="secondary" bindtap="moreEvidence">继续读取</button></view>
</view>
