.tabs{display:flex;gap:8rpx;background:#D8F0E0;padding:8rpx;border-radius:18rpx}.tabs button{flex:1;width:auto;min-height:76rpx;line-height:60rpx;font-size:26rpx;border-radius:12rpx}.tabs .secondary{background:transparent;color:#6A8071}.tabs .primary{background:#157448;color:#fff}.thumbnail{flex-shrink:0;width:148rpx;height:148rpx;border-radius:18rpx;background:#E3EDE5}.section-title{font-size:30rpx;line-height:1.5}.panel.section{margin-top:24rpx}.panel .muted{font-size:24rpx}.panel .line{font-size:25rpx;padding:20rpx 0}.panel .actions{padding-top:22rpx;border-top:1rpx solid #EAF0EB}.panel .actions button{min-height:76rpx;line-height:76rpx}
