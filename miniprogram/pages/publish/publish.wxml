<view class="page"><view class="row"><view class="title">{{id ? '编辑商品' : '发布一件闲置'}}</view><text wx:if="{{id}}" class="muted" bindtap="newProduct">改为新发布</text></view><view class="subtitle">写清细节，让下一位同学放心接手</view><view wx:if="{{!user}}" class="empty">请先登录<button class="primary" bindtap="login">去登录</button></view><view wx:elif="{{user.certificationStatus !== 'VERIFIED'}}" class="empty">通过学生实名认证后即可发布<button class="primary" bindtap="certify">查看认证</button></view><block wx:else><view class="panel section"><view class="field-label">实拍图片 <text class="muted">{{images.length}}/9</text></view><view class="photos"><view wx:for="{{images}}" wx:key="id" class="photo"><image src="{{item.path}}" mode="aspectFill"/><text class="remove" data-index="{{index}}" bindtap="removePhoto">×</text></view><view wx:if="{{images.length < 9}}" class="add-photo" bindtap="photos">{{uploading ? '上传中…' : '＋ 添加图片'}}</view></view><view class="safe-note">至少一张图片，单张不超过5MB。请勿上传含学号或联系方式的图片。</view></view><view class="panel"><view class="field"><text class="field-label">商品标题</text><input value="{{title}}" data-field="title" bindinput="input" placeholder="例如：高等数学教材 第七版" maxlength="50"/></view><view class="field"><text class="field-label">分类</text><picker range="{{categories}}" range-key="name" value="{{categoryIndex}}" data-field="categoryIndex" bindchange="choose"><view class="picker">{{categories[categoryIndex].name || '请选择分类'}}</view></picker></view><view class="row"><view class="field grow"><text class="field-label">转让价格（元）</text><input type="digit" value="{{price}}" data-field="price" bindinput="input" placeholder="0.00"/></view><view class="field grow"><text class="field-label">新旧程度</text><picker range="{{conditions}}" value="{{conditionIndex}}" data-field="conditionIndex" bindchange="choose"><view class="picker">{{conditions[conditionIndex]}}</view></picker></view></view><view class="field"><text class="field-label">商品描述</text><textarea value="{{description}}" data-field="description" bindinput="input" placeholder="说明使用情况、配件和瑕疵，勿填写联系方式" maxlength="2000"/></view><view class="safe-note">发布及修改后均需审核，通过后展示到商品列表。</view><button class="primary" loading="{{busy || uploading}}" disabled="{{busy || uploading}}" bindtap="submit">{{id ? '保存并重新审核' : '提交审核'}}</button></view></block><view wx:if="{{error}}" class="error">{{error}}</view></view>
