.summary{padding-top:26rpx}.order-state{font-size:42rpx;font-weight:700;color:#C74312}.order-no{font-size:21rpx;color:#879087}.product-row{align-items:flex-start;padding:24rpx 0;margin-top:22rpx;border-top:1rpx solid #EDF1ED}.thumbnail{flex-shrink:0;width:148rpx;height:148rpx;border-radius:12rpx;background:#E3EDE5}.product-title{font-size:31rpx;font-weight:600;line-height:1.45;margin-bottom:8rpx}.action-grid{display:flex;flex-wrap:wrap}.action-grid button{flex:1 1 42%;width:auto}.party-role{display:inline-block;width:68rpx;color:#7A8D7F;font-size:23rpx}.party-name{font-size:28rpx;font-weight:600}.timeline-item{display:flex;align-items:flex-start;gap:18rpx;position:relative;padding:0 0 28rpx 8rpx}.timeline-item:last-child{padding-bottom:0}.timeline-dot{flex-shrink:0;width:18rpx;height:18rpx;border-radius:50%;background:#CF4710;margin-top:12rpx}.timeline-title{font-size:27rpx;font-weight:600}.timeline-time{font-size:21rpx;color:#98A097;margin-top:4rpx}.stars{color:#CF7A18;font-size:28rpx}.reviewer{font-size:25rpx;font-weight:600}.review-content{font-size:25rpx;color:#5F685D;margin-top:10rpx;white-space:pre-wrap}.star-row{display:flex;gap:10rpx;margin-bottom:22rpx}.star-row .star-button{flex:1;width:auto;min-height:70rpx;line-height:54rpx;font-size:24rpx;background:#F5F6F2;color:#7A8378;border:1rpx solid #E2E7DF;border-radius:10rpx}.star-row .star-button.selected{background:#FFF0E5;color:#BD4B16;border-color:#E9B291}.evaluation-form textarea{margin-bottom:24rpx}
