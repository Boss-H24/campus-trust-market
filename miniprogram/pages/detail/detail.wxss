.gallery { height:600rpx; background:#fff; }.gallery image { width:100%; height:100%; }
.detail-page { padding:24rpx 24rpx 55rpx; }.panel { border-radius:20rpx; border-color:#ECEBE5; padding:28rpx; }.overview { padding-top:22rpx; }.price { color:#DF4516; font-size:60rpx; letter-spacing:-1rpx; line-height:1.3; }.currency { font-size:34rpx; margin-right:5rpx; }.product-name { margin-top:22rpx; font-size:38rpx; font-weight:700; line-height:1.45; color:#30352F; }
.detail-tags { display:flex; flex-wrap:wrap; align-items:center; gap:18rpx; margin-top:20rpx; font-size:24rpx; color:#868A80; }.condition-tag { color:#526F5A; background:#EDF4EC; border-radius:6rpx; padding:4rpx 12rpx; }
.section-title { color:#30352F; font-size:30rpx; font-weight:600; margin-bottom:18rpx; }.description { white-space:pre-wrap; line-height:1.95; color:#61685B; font-size:27rpx; }
.seller-mark { flex-shrink:0; width:78rpx; height:78rpx; line-height:78rpx; border-radius:25rpx; background:#E7EFE3; text-align:center; color:#60805A; font-size:25rpx; }.seller-name { font-size:30rpx; font-weight:600; margin-bottom:10rpx; }.seller-credit { color:#4D7654; font-size:44rpx; font-weight:700; line-height:1.2; text-align:right; }.seller-credit text { display:block; font-size:21rpx; font-weight:400; margin-top:8rpx; }
.seller-privacy { display:flex; flex-wrap:wrap; gap:24rpx; font-size:23rpx; color:#818D7D; padding-top:24rpx; margin-top:24rpx; border-top:1rpx solid #EEF1E9; }.privacy-note { color:#8D9687; font-size:21rpx; margin-top:12rpx; }
.review-link{color:#B54B1C;font-size:24rpx;margin-top:18rpx}.reviews-panel .review-item{padding:20rpx 0}.reviewer{font-size:25rpx;font-weight:600}.review-stars{color:#CF7A18;font-size:25rpx}.review-text{display:block;margin-top:10rpx;color:#5E685D;font-size:24rpx;line-height:1.75}.order-button{margin-bottom:8rpx}
