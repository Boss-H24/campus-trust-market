.gallery{height:560rpx;background:#E3EDE5;border-radius:0 0 32rpx 32rpx;overflow:hidden}.gallery image{width:100%;height:100%}.title{font-size:40rpx;line-height:1.45}.price{font-size:56rpx;letter-spacing:-1rpx}.description{white-space:pre-wrap;line-height:1.95;color:#4E6658;font-size:27rpx}.seller-credit{color:#166855;font-size:42rpx;font-weight:700;white-space:nowrap}.seller-credit text{display:block;font-size:22rpx;font-weight:400;text-align:right}.panel .section-title{margin-bottom:16rpx}.panel .safe-note{padding-top:20rpx;border-top:1rpx solid #EDF1ED}.gallery+.page{padding-top:30rpx}
