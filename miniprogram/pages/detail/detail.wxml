<view wx:if="{{error}}" class="page error" bindtap="load">{{error}}，点击重试</view>
<block wx:if="{{product}}">
  <swiper indicator-dots indicator-color="#D8DCD4" indicator-active-color="#CF4710" class="gallery"><swiper-item wx:for="{{images}}" wx:key="*this"><image src="{{item}}" mode="aspectFit" data-path="{{item}}" bindtap="preview"/></swiper-item></swiper>
  <view class="page detail-page">
    <view class="panel overview"><view class="row"><text class="price"><text class="currency">¥</text>{{product.priceText}}</text><text class="badge {{product.status === 'PENDING' ? 'warning' : ''}}">{{product.statusText}}</text></view><view class="product-name">{{product.title}}</view><view class="detail-tags"><text class="condition-tag">{{conditionText}}</text><text>校内当面交接</text></view><view wx:if="{{own && product.rejectionReason}}" class="error">审核意见：{{product.rejectionReason}}</view></view>
    <view class="panel"><view class="section-title">成色与说明</view><text class="description" user-select>{{product.description}}</text></view>
    <view class="panel seller-panel"><view class="row"><view class="seller-mark">同学</view><view class="grow"><view class="seller-name">{{product.seller.nickname}}</view><text class="badge">{{product.seller.certificationStatus === 'VERIFIED' ? '已认证学生' : '未认证'}}</text></view><view class="seller-credit">{{product.seller.creditScore}}<text>信誉分</text></view></view><view class="seller-privacy"><text>姓名 {{product.seller.maskedName}}</text><text>手机号 {{product.seller.maskedPhone}}</text></view><view class="privacy-note">身份信息已脱敏，学号不会公开展示</view></view>
    <button wx:if="{{own && (product.status === 'ON_SALE' || product.status === 'PENDING' || product.status === 'REJECTED' || product.status === 'OFF_SHELF')}}" class="primary" bindtap="edit">编辑商品</button>
    <view class="safe-note">请在校内公共区域交接，核验商品后再确认交易。</view>
  </view>
</block>
