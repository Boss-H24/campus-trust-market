<view wx:if="{{error}}" class="page error" bindtap="load">{{error}}，点击重试</view><block wx:if="{{product}}"><swiper indicator-dots class="gallery"><swiper-item wx:for="{{images}}" wx:key="*this"><image src="{{item}}" mode="aspectFit" data-path="{{item}}" bindtap="preview"/></swiper-item></swiper><view class="page"><view class="row"><text class="price">¥{{product.priceText}}</text><text class="badge {{product.status === 'PENDING' ? 'warning' : ''}}">{{product.statusText}}</text></view><view class="title section">{{product.title}}</view><view class="subtitle">{{conditionText}} · 校内当面交接</view><view wx:if="{{own &amp;&amp; product.rejectionReason}}" class="error">审核意见：{{product.rejectionReason}}</view><view class="panel section"><view class="section-title">商品详情</view><text class="description" user-select>{{product.description}}</text></view><view class="panel"><view class="row"><view><view class="section-title">{{product.seller.nickname}}</view><text class="badge">{{product.seller.certificationStatus === 'VERIFIED' ? '已认证学生' : '未认证'}}</text></view><view class="seller-credit">{{product.seller.creditScore}}<text> 信誉分</text></view></view><view class="safe-note">姓名 {{product.seller.maskedName}}　手机号 {{product.seller.maskedPhone}}</view></view><button wx:if="{{own &amp;&amp; (product.status === 'ON_SALE' || product.status === 'PENDING' || product.status === 'REJECTED' || product.status === 'OFF_SHELF')}}" class="primary" bindtap="edit">编辑商品</button><view class="safe-note">请在校内公共区域交接，核验商品后再确认交易。</view></view></block>
