page { background:#F3F7F5; color:#183B31; font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif; font-size:28rpx; line-height:1.55; }
view,text,input,textarea,button { box-sizing:border-box; }
button::after { border:0; }
button { font-size:28rpx; border-radius:12rpx; margin:0; }
.page { padding:32rpx; padding-bottom:70rpx; }
.title { font-size:44rpx; line-height:1.25; font-weight:700; letter-spacing:-1rpx; }
.subtitle { color:#64746E; font-size:25rpx; margin-top:12rpx; }
.section { margin-top:32rpx; }
.section-title { font-size:32rpx; font-weight:650; margin-bottom:20rpx; }
.panel { background:#fff; border-radius:18rpx; padding:28rpx; margin-bottom:24rpx; }
.primary { background:#166855; color:#fff; font-weight:600; padding:8rpx 22rpx; }
.secondary { background:#E5EFEA; color:#166855; padding:8rpx 22rpx; }
.danger { color:#A13F39; background:#FBEFEC; padding:8rpx 22rpx; }
.small { font-size:24rpx; padding:0 20rpx; line-height:66rpx; }
.muted { color:#64746E; font-size:25rpx; }
.row { display:flex; align-items:center; justify-content:space-between; gap:18rpx; }
.grow { flex:1; min-width:0; }
.badge { display:inline-block; padding:5rpx 14rpx; border-radius:8rpx; font-size:22rpx; background:#E5EFEA; color:#166855; }
.warning { background:#FFF3D7; color:#8A640E; }
.rejected { background:#FBEFEC; color:#A13F39; }
.empty { padding:76rpx 32rpx; text-align:center; color:#64746E; }
.empty .primary { margin-top:24rpx; }
.error { margin:20rpx 0; padding:20rpx; background:#FBEFEC; color:#A13F39; border-radius:12rpx; }
.field { margin-bottom:28rpx; }
.field-label { display:block; margin-bottom:12rpx; font-size:26rpx; font-weight:600; }
input,textarea { width:100%; border:1rpx solid #D5E1DB; background:#fff; border-radius:10rpx; padding:20rpx; font-size:28rpx; }
input { height:88rpx; }
textarea { height:220rpx; }
.picker { padding:20rpx; border:1rpx solid #D5E1DB; border-radius:10rpx; }
.price { color:#986B13; font-weight:700; font-size:34rpx; }
.actions { display:flex; gap:16rpx; margin-top:24rpx; }
.actions button { flex:1; }
.line { border-bottom:1rpx solid #E5ECE8; padding:24rpx 0; }
.line:last-child { border-bottom:0; }
.avatar { width:88rpx; height:88rpx; border-radius:50%; background:#D9E9E1; color:#166855; font-size:38rpx; display:flex; align-items:center; justify-content:center; overflow:hidden; }
.avatar image { width:100%; height:100%; }
.safe-note { margin:24rpx 0; font-size:23rpx; color:#64746E; line-height:1.7; }
